<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hostflow</groupId>
        <artifactId>hostflow-backend</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>app</artifactId>
    <packaging>jar</packaging>
    <name>app</name>
    <description>Runnable HostFlow modular monolith — wires every module together</description>

    <dependencies>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>core-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>core-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>core-persistence</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>core-tenancy</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>core-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>core-messaging</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-analytics</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-billing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-booking</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-crm</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-identity</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-maintenance</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-mall</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-marketing</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-notification</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-office</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-platform-admin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-property</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-rental</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.hostflow</groupId>
            <artifactId>module-review</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.20.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <version>1.20.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <version>1.20.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.2.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.hostflow.app.HostFlowApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
