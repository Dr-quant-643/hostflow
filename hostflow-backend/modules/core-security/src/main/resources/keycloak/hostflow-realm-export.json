{
  "realm": "hostflow",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 2592000,
  "roles": {
    "realm": [
      { "name": "xanuos_owner", "description": "Property owner on XanuOS" },
      { "name": "xanuos_manager", "description": "Property manager on XanuOS" },
      { "name": "xanuos_staff", "description": "Operational staff on XanuOS" },
      {
        "name": "nazilco_customer",
        "description": "Customer-facing user on NazilCo"
      },
      {
        "name": "platform_admin",
        "description": "Cross-product HostFlow platform administrator"
      }
    ]
