# Copy to .env.prod, fill in real values, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Every value below is a placeholder. Do not deploy with any value still
# reading "changeme" or matching a dev-secret-* pattern from the local
# setup -- those are only safe on localhost.

# --- Database (Postgres) ---
DB_NAME=hostflow
DB_SUPERUSER=postgres
DB_SUPERUSER_PASSWORD=changeme
APP_USERNAME=hostflow_app
APP_DB_PASSWORD=changeme
MIGRATIONS_USERNAME=hostflow_migrations
MIGRATIONS_DB_PASSWORD=changeme
PLATFORM_ADMIN_USERNAME=hostflow_platform_admin
PLATFORM_ADMIN_DB_PASSWORD=changeme
# After first `docker compose up`, run create-roles.sql (with these same
# passwords) against the postgres service once -- V2__create_database_roles.sql
# handles this automatically via Flyway using DB_SUPERUSER credentials, but
# see PROJECT_STATE.md if hostflow_migrations needs elevated grants on your
# Postgres provider.

# --- Redis ---
REDIS_PASSWORD=changeme

# --- RabbitMQ ---
RABBITMQ_USERNAME=hostflow
RABBITMQ_PASSWORD=changeme

# --- Keycloak ---
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
# The real public URL Keycloak will be reached at (behind your reverse
# proxy/load balancer, with TLS terminated there or on Keycloak itself).
KEYCLOAK_PUBLIC_URL=https://auth.example.com
# service-account secret for the hostflow-admin-cli client (used by
# KeycloakProvisioningService for user creation). ROTATE this from the
# checked-in dev-secret-hostflow-admin-cli value before going live.
KEYCLOAK_ADMIN_CLIENT_SECRET=changeme

# --- Object storage (MinIO self-hosted, or point STORAGE_PUBLIC_ENDPOINT at
# a real S3-compatible provider instead and skip the minio service) ---
STORAGE_ACCESS_KEY=changeme
STORAGE_SECRET_KEY=changeme
STORAGE_BUCKET=hostflow-prod
# The URL presigned photo/document URLs will actually be reachable at --
# NOT the internal docker service name, since guests' browsers hit this
# directly.
STORAGE_PUBLIC_ENDPOINT=https://storage.example.com

# --- CORS: real public URLs of the 5 frontend apps (Vercel deployments or
# custom domains) that are allowed to call this API ---
CORS_ORIGIN_1=https://app.example.com
CORS_ORIGIN_2=https://stay.example.com
CORS_ORIGIN_3=
CORS_ORIGIN_4=
CORS_ORIGIN_5=

# --- Gateway ---
GATEWAY_PUBLIC_PORT=8085

# --- SMTP (real provider -- see PROJECT_STATE.md gap #6) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- SMS (Africa's Talking) / Push (FCM) -- also gap #6, leave blank until
# you have real accounts; SmsDeliveryService/PushDeliveryService fail loud
# (not silently) when these are unset and something actually tries to send. ---
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
FCM_SERVER_KEY=

# --- AI (module-ai, not yet built -- see PROJECT_STATE.md "What's NEXT") ---
FASTAPI_BASE_URL=http://localhost:9000
