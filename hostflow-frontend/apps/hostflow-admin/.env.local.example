NEXT_PUBLIC_API_BASE_URL=http://localhost:8085/api/v1

# Shared by both workspaces below — redirect URIs are derived from this +
# each workspace's basePath, never set separately.
APP_BASE_URL=http://localhost:3002

# XanuOS admin identity — fully separate account/session from NazilCo admin below
XANUOS_ADMIN_KEYCLOAK_ISSUER=http://localhost:8081/realms/hostflow
XANUOS_ADMIN_KEYCLOAK_CLIENT_ID=hostflow-admin-xanuos
XANUOS_ADMIN_KEYCLOAK_CLIENT_SECRET=changeme
XANUOS_ADMIN_SESSION_SECRET=dev-only-32-char-minimum-secret-change-me

# NazilCo admin identity — fully separate account/session from XanuOS admin above
NAZILCO_ADMIN_KEYCLOAK_ISSUER=http://localhost:8081/realms/hostflow
NAZILCO_ADMIN_KEYCLOAK_CLIENT_ID=hostflow-admin-nazilco
NAZILCO_ADMIN_KEYCLOAK_CLIENT_SECRET=changeme
NAZILCO_ADMIN_SESSION_SECRET=dev-only-32-char-minimum-secret-change-me-different-from-xanuos
