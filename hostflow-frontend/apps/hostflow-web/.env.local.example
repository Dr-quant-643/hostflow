NEXT_PUBLIC_API_BASE_URL=http://localhost:8085/api/v1

# Shared by both products below — redirect URIs are derived from this +
# each product's basePath (e.g. XanuOS's callback becomes
# ${APP_BASE_URL}/xanuos/api/auth/callback), never set separately.
APP_BASE_URL=http://localhost:3000

# XanuOS product identity — fully separate account/session from NazilCo below
XANUOS_KEYCLOAK_ISSUER=http://localhost:8081/realms/hostflow
XANUOS_KEYCLOAK_CLIENT_ID=hostflow-web-xanuos
XANUOS_KEYCLOAK_CLIENT_SECRET=changeme
XANUOS_SESSION_SECRET=dev-only-32-char-minimum-secret-change-me

# NazilCo product identity — fully separate account/session from XanuOS above
NAZILCO_KEYCLOAK_ISSUER=http://localhost:8081/realms/hostflow
NAZILCO_KEYCLOAK_CLIENT_ID=hostflow-web-nazilco
NAZILCO_KEYCLOAK_CLIENT_SECRET=changeme
NAZILCO_SESSION_SECRET=dev-only-32-char-minimum-secret-change-me-different-from-xanuos
