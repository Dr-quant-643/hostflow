{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "VERCEL",
        "NEXT_PUBLIC_*",
        "KEYCLOAK_*",
        "SESSION_SECRET",
        "APP_BASE_URL",
        "DEV_MOCK_*",
        "XANUOS_*",
        "NAZILCO_*",
        "XANUOS_ADMIN_*",
        "NAZILCO_ADMIN_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
